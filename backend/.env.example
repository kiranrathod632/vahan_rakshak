PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
APP_BASE_URL=http://localhost:5000

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/gadiraksha_db

# JWT Secret for Authentication
JWT_SECRET=gadiraksha_super_secret_jwt_key_2026_xyz!@#
JWT_EXPIRES_IN=30d

# SMS & WhatsApp Service Configuration (Twilio / Fast2SMS / Meta Cloud API)
# Providers can be easily swapped in notificationService.js
SMS_PROVIDER=FAST2SMS # Options: CONSOLE, FAST2SMS, TWILIO, WHATSAPP_CLOUD
FAST2SMS_API_KEY=your_fast2sms_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Admin secret key to batch generate physical stickers
ADMIN_API_KEY=gadiraksha_admin_secret_batch_gen_key_2026
