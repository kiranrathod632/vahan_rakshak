{
  "name": "gadiraksha-monorepo",
  "version": "1.0.0",
  "description": "Smart Vehicle QR Emergency & No-Parking Alert Platform (Monorepo)",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "node backend/src/server.js",
    "backend": "node backend/src/server.js",
    "backend:dev": "node backend/src/server.js",
    "frontend": "npm --prefix frontend run dev",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build && node -e \"const fs=require('fs'); fs.cpSync('frontend/dist', 'backend/public', {recursive:true});\"",
    "build": "npm --prefix frontend run build && node -e \"const fs=require('fs'); fs.cpSync('frontend/dist', 'backend/public', {recursive:true});\"",
    "client:dev": "npm --prefix frontend run dev",
    "seed": "node backend/scripts/seedDemoSales.js",
    "check-admin": "node backend/scripts/checkAdmin.js"
  },
  "keywords": [
    "vehicle-safety",
    "qr-code",
    "sos-alert",
    "no-parking-alert",
    "nodejs",
    "mongodb",
    "socketio",
    "react",
    "vite"
  ],
  "author": "GadiRaksha Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
